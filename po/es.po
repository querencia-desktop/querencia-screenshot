#: src/ui.rs:89
msgid "Select an _area"
msgstr "Seleccionar un á_rea"

#: src/ui.rs:90
msgid "Drag a rectangle while holding the mouse button. Esc cancels."
msgstr ""
"Arrastre un rectángulo manteniendo pulsado el botón del ratón. Esc cancela."

#: src/ui.rs:208
msgid "What would you like to capture?"
msgstr "¿Qué desea capturar?"

#: src/ui.rs:215
msgid "After the capture the editor opens for annotating, saving and copying."
msgstr "Tras la captura se abre el editor para anotar, guardar y copiar."

#: src/ui.rs:267
#, no-c-format
msgid ""
"Missing programs: {programs}. Window and area need slurp, copying needs wl-copy (package wl-clipboard)."
msgstr ""
"Faltan programas: {programs}. Ventana y área necesitan slurp; copiar necesita wl-copy (paquete wl-clipboard)."

#: src/ui.rs:402
msgid "Cancelled – nothing captured."
msgstr "Cancelado: no se ha capturado nada."
