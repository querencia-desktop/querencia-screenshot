[Desktop Entry]
# Querencia Screenshot. Desktop-ID = GApplication-ID = StartupWMClass
# org.querencia.Screenshot. Startet das Auswahlfenster; danach öffnet sich
# der Editor. Die Druck-Taste läuft über den Runtime-Starter
# querencia-screenshot-start und ist nicht Teil dieser Datei.
# Vorlage: Name, GenericName, Comment und Keywords sind englisch; die
# Übersetzungen (Name[de]= …) setzt `werkzeug/i18n.py desktop` aus po/*.po
# ein (entspricht msgfmt --desktop). Erzeugt: org.querencia.Screenshot.desktop.
# Exec/TryExec ohne Pfad; die Integration setzt die Ablage ein.
Type=Application
Version=1.5
Name[de]=Bildschirmfoto aufnehmen
Name[es]=Capturar pantalla
Name[fr]=Capture d’écran
Name[it]=Cattura schermata
Name=Take Screenshot
GenericName[de]=Bildschirmfoto
GenericName[es]=Captura de pantalla
GenericName[fr]=Capture d’écran
GenericName[it]=Schermata
GenericName=Screenshot
Comment[de]=Ein Bildschirmfoto des Bildschirms, eines Fensters oder eines Bereichs aufnehmen und markieren
Comment[es]=Capturar la pantalla, una ventana o un área y anotarla
Comment[fr]=Capturer l’écran, une fenêtre ou une zone et l’annoter
Comment[it]=Cattura lo schermo, una finestra o un’area e aggiungi annotazioni
Comment=Take a screenshot of the screen, a window or an area and annotate it
Exec=querencia-screenshot
TryExec=querencia-screenshot
Icon=org.querencia.Screenshot
Terminal=false
Categories=GTK;Utility;
Keywords[de]=Bildschirmfoto;Screenshot;Aufnahme;
Keywords[es]=Captura;Pantalla;Capturar;Screenshot;
Keywords[fr]=Capture;Écran;Screenshot;
Keywords[it]=Schermata;Cattura;Schermo;Screenshot;
Keywords=Screenshot;Capture;Screen;
StartupNotify=true
StartupWMClass=org.querencia.Screenshot
